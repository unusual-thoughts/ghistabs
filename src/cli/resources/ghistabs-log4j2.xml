<?xml version="1.0" encoding="UTF-8"?>

<!--
	Replaces Ghidra's generic.log4j.xml for the CLI (`-Dlog4j.configurationFile=ghistabs-log4j2.xml`,
	which LoggingInitialization resolves off the classpath). Same appenders as Ghidra's, except its
	console one — which writes past the mordant terminal and strands progress-bar frames — is swapped
	for BarSinkAppender. `packages` is what lets log4j find that class; it has no plugin descriptor.

	`logFilename` is set by LoggingInitialization before it reads this file.
-->
<Configuration monitorInterval="30" packages="ghistabs.cli">
	<Appenders>
		<BarSink name="bar"/>
		<RollingFile
			name="detail"
			fileName="${sys:logFilename}"
			filePattern="${sys:logFilename}-%d{yyyy-MM-dd}-%i.log">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p (%c{1}) %m %ex %n"/>
			<Policies>
				<SizeBasedTriggeringPolicy size="50000 KB"/>
			</Policies>
			<DefaultRolloverStrategy max="20"/>
		</RollingFile>
	</Appenders>

	<Loggers>
		<Root level="ALL">
			<AppenderRef ref="bar" level="INFO"/>
			<AppenderRef ref="detail" level="DEBUG"/>
		</Root>
	</Loggers>
</Configuration>
