[*.{kt,kts}]
# ktlint_standard = disabled # Disable all rules from the `standard` rule set provided by KtLint
ktlint_standard_no-wildcard-imports = disabled
ktlint_code_style = intellij_idea
ktlint_standard_max-line-length = enabled
max_line_length = 120
ktlint_standard_no-empty-file = disabled
ij_kotlin_wrap_expression_body_functions = unset
# Always `import ghidrakt.*`, never its names one by one: the compat shims under ghidrakt's kotlin-pre*/kotlin-since*
# source sets only exist for some Ghidra versions, so an IDE building against one version would otherwise rewrite the
# import to the names it sees and drop the ones another version needs.
ij_kotlin_packages_to_use_import_on_demand = java.util.*,kotlinx.android.synthetic.**,io.ktor.**,ghidrakt.*
